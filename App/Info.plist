<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>loopl</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>shortcuts</string>
		<string>maps</string>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
		<string>music</string>
		<string>tinyapp</string>
		<string>x-callback-url</string>
		<string>facetime</string>
		<string>comgooglemaps</string>
		<string>spotify</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>Tell the model which song is playing when you ask. Nothing leaves this device.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Let the model read your calendar and add events you approve. Nothing leaves this device.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to show the model. It never leaves this device.</string>
	<key>NSContactsUsageDescription</key>
	<string>Let the model look up a name in your contacts when you ask. Nothing is changed or sent anywhere.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Tell the model where you are when it asks — your city by default, exact position only when you allow it. Nothing leaves this device.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a message for the model to transcribe. Audio never leaves this device.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save pictures the model produced to your library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Let the model see your newest photos when you ask — Selected Photos is enough. Nothing leaves this device.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Let the model read your reminders and add ones you approve. Nothing leaves this device.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
